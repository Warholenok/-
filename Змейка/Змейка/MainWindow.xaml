<Window x:Class="SnakeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake Studio"
        Width="1100" Height="800"
        MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1019"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#27364B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#131D2B"/>
            <Setter Property="BorderBrush" Value="#26354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA3BC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="SNAKE / STUDIO"
                           FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Классическая игра. Новый ритм."
                           Foreground="#8FA3BC"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#15332F"
                    CornerRadius="16"
                    Padding="14,8">
                <TextBlock Text="●  PLAY / GROW / REPEAT"
                           Foreground="#6EE7B7"
                           FontSize="11"/>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="СЧЁТ" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="ScoreText" Text="0"
                               Foreground="#6EE7B7"
                               FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="РЕКОРД СЕССИИ"
                               Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="BestText" Text="0"
                               FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ДЛИНА"
                               Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="LengthText" Text="4"
                               FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Background="#101926"
                    BorderBrush="#29394E"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="GameCanvas"
                                Width="672" Height="528"
                                Background="#101926"
                                ClipToBounds="True"/>
                    </Viewbox>

                    <Border x:Name="Overlay"
                            Background="#EF101926"
                            BorderBrush="#33475F"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="26"
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="OverlayTitle"
                                       Text="Готовы к игре?"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="OverlayText"
                                       Text="Собирайте яблоки и избегайте стен."
                                       Foreground="#A5B7CD"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,12,0,22"/>
                            <Button x:Name="PlayButton"
                                    Content="Начать игру"
                                    Background="#6EE7B7"
                                    Foreground="#09241D"
                                    Click="Play_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ВАША ИГРА"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="StateText"
                                   Text="Ожидание"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="СКОРОСТЬ"
                                   Style="{StaticResource Caption}"/>
                        <ComboBox x:Name="SpeedBox"
                                  SelectedIndex="1"
                                  Foreground="#142033"
                                  Padding="8"
                                  FontSize="13"
                                  Focusable="False">
                            <ComboBoxItem Content="Спокойная"/>
                            <ComboBoxItem Content="Классическая"/>
                            <ComboBoxItem Content="Быстрая"/>
                        </ComboBox>
                        <TextBlock Text="Для следующей новой игры"
                                   Foreground="#8FA3BC"
                                   FontSize="10"
                                   Margin="0,8,0,22"/>

                        <Button x:Name="PauseButton"
                                Content="Пауза"
                                Click="Pause_Click"
                                Margin="0,0,0,10"/>
                        <Button Content="Новая игра"
                                Background="#6EE7B7"
                                Foreground="#09241D"
                                Click="NewGame_Click"/>

                        <Border Height="1" Background="#29394E"
                                Margin="0,24"/>

                        <TextBlock Text="УПРАВЛЕНИЕ"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock Text="↑ ↓ ← → / WASD"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Пробел — пауза&#10;Enter — старт / продолжить"
                                   Foreground="#A5B7CD"
                                   FontSize="12"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                        <Border Height="1" Background="#29394E"
                                Margin="0,24"/>

                        <TextBlock Text="●  Яблоко: +10"
                                   Foreground="#FB7185"/>
                        <TextBlock Text="●  Золотое: +30"
                                   Foreground="#FBBF24"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Каждая пятая еда — золотая."
                                   Foreground="#8FA3BC"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="Не торопитесь. Планируйте следующий поворот."
                   Foreground="#71869F"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0"/>
    </Grid>
</Window>